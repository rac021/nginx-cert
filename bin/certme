#!/usr/bin/env bash
# certme -- nginx-cert command line interface.
#
#   docker exec <container> certme status
#   docker exec <container> certme renew --force
set -euo pipefail

NC_ROOT="${NC_ROOT:-/opt/nginx-cert}"
# shellcheck source=../lib/bootstrap.sh
source "${NC_ROOT}/lib/bootstrap.sh"

usage() {
  cat <<'EOF'
certme -- manage nginx-cert TLS certificates

USAGE
    certme <command> [options]

COMMANDS
    issue [name...]     Issue or renew the certificates that need it.
                        With no argument: every declared certificate.
    renew [name...]     Alias for "issue".
    status [--json]     State of each certificate (authority, expiry, whether a
                        renewal is due).
    list                List declared certificates and their domains.
    providers           Known certificate authorities and their availability.
    config              Effective configuration, secrets masked.
    render              Regenerate the nginx configuration from the templates.
    check               Validate the nginx configuration (nginx -t).
    reload              Validate, then reload nginx.
    revoke <name>       Revoke a certificate with its issuing authority.
    health              Health probe (used by the Docker HEALTHCHECK).
    version             Version of nginx-cert and its components.

OPTIONS
    --force             Renew even if the certificate is still valid.
    --json              Machine-readable output ("status" command).
    -h, --help          Show this help.

EXIT CODES
    0  success          3  no authority could issue the certificate
    1  failure          4  invalid nginx configuration
    2  configuration    5  another operation is already running
EOF
}

# --- Applying changes ------------------------------------------------------
#
# After an issuance the nginx configuration must be regenerated (a new
# certificate may create a server that did not exist), validated, then
# reloaded. If validation fails we roll back: a stale certificate is better
# than an nginx that refuses to start.
cmd::apply_changes() {
  ((${#NC_CHANGED[@]} == 0)) && return 0

  nginx::render || return "$EX_NGINX"

  if ! nginx::test; then
    log::error "The configuration produced after renewal is invalid: rolling back."
    local name
    for name in "${NC_CHANGED[@]}"; do certs::rollback "$name" || true; done
    nginx::render || true
    nginx::test || log::error "The configuration is still invalid after rollback: manual intervention required."
    return "$EX_NGINX"
  fi

  nginx::reload || return "$EX_NGINX"

  if [[ -n ${CFG_POST_HOOK:-} ]]; then
    log::info "Running CERT_POST_HOOK…"
    if CERTME_CHANGED="${NC_CHANGED[*]}" bash -c "$CFG_POST_HOOK"; then
      log::ok "CERT_POST_HOOK finished."
    else
      log::warn "CERT_POST_HOOK returned an error (the renewal itself stands)."
    fi
  fi
  return 0
}

# --- Commands --------------------------------------------------------------

# Everything that must not run concurrently with another certme process.
#
# Its own status is deliberately discarded: the outcome of the run is read from
# NC_CHANGED / NC_RESCUED / NC_FAILED just below. Returning it through
# lock::with would make it indistinguishable from a lock that could not be
# taken -- and issue::all's "2 = nothing to renew" collides exactly with
# EX_CONFIG, so a read-only /data was reported as a successful run.
cmd::_issue_locked() {
  bootstrap::cleanup_staging
  issue::all "$@" || true
}

cmd::issue() {
  local -a only=("$@")

  if ! util::is_true "$CFG_ENABLE"; then
    log::warn "CERT_ENABLE=false: certificate management is disabled."
    return 0
  fi
  ((${#NC_SPEC_NAMES[@]} == 0)) && { log::warn "No certificate declared (CERT_DOMAINS is empty)."; return 0; }

  # Optionally restrict the run to a subset of certificates.
  #
  # The subset is passed to issue::all; NC_SPEC_NAMES is left alone. It is also
  # the list the nginx configuration is rendered from, and narrowing it here
  # made "certme issue one-site" delete every other site's server block and
  # reload -- taking sites offline that the command never mentioned.
  local -a targets=()
  if ((${#only[@]})); then
    local n found d
    for n in "${only[@]}"; do
      found=0
      for d in "${NC_SPEC_NAMES[@]}"; do [[ $d == "$n" ]] && { targets+=("$n"); found=1; }; done
      ((found)) || log::die "$EX_CONFIG" "Unknown certificate: '${n}'. See 'certme list'."
    done
  fi

  bootstrap::prepare_dirs

  # Staging directories belong to whoever holds the lock: cleaning them up
  # before taking it deleted the directory a concurrent run was writing into.
  #
  # Since cmd::_issue_locked always succeeds, anything non-zero here comes from
  # the lock itself and means nothing ran at all. Only EX_BUSY used to be
  # propagated, so an unopenable lock file -- a read-only volume, a directory
  # owned by someone else -- printed a summary of zeros and exited 0: the
  # scheduler's "certme issue || warn" never warned, and a container that had
  # stopped renewing altogether reported success until the certificate expired.
  local lock_rc=0
  lock::with "$CFG_LOCK_FILE" 0 cmd::_issue_locked ${targets[@]+"${targets[@]}"} || lock_rc=$?
  ((lock_rc)) && return "$lock_rc"

  local apply_rc=0
  cmd::apply_changes || apply_rc=$?
  issue::report

  ((apply_rc != 0)) && return "$apply_rc"
  # A certificate the local authority had to rescue is not a success: the site
  # is up, and every browser warns.
  ((${#NC_FAILED[@]} + ${#NC_RESCUED[@]})) && return "$EX_ISSUE"
  return 0
}

cmd::status() {
  local json=false
  [[ ${1:-} == --json ]] && json=true

  if $json; then
    local out='' name
    for name in ${NC_SPEC_NAMES[@]+"${NC_SPEC_NAMES[@]}"}; do
      out+="${out:+,}$(certs::status_json_one "$name")"
    done
    printf '{"version":"%s","certificates":[%s]}\n' "$NC_VERSION" "$out"
    return 0
  fi

  if ((${#NC_SPEC_NAMES[@]} == 0)); then
    printf '%sNo certificate declared.%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi

  # Pad first, colour second. Escape sequences carry no display width, so a
  # printf field width applied to an already-coloured string counts the escape
  # bytes and shifts every following column.
  local fmt='%-28s %s %-26s %-9s %s\n'
  printf "$C_BOLD$fmt$C_RESET" 'CERTIFICATE' 'STATE        ' 'AUTHORITY' 'EXPIRES' 'DOMAINS'
  printf '%s%s%s\n' "$C_DIM" "$(printf -- '-%.0s' $(seq 1 92))" "$C_RESET"

  local name state color issuer days reason padded
  for name in "${NC_SPEC_NAMES[@]}"; do
    if ! certs::exists "$name"; then
      printf -v padded '%-13s' 'missing'
      printf "$fmt" "$name" "${C_RED}${padded}${C_RESET}" '-' '-' "${NC_SPEC_DOMAINS[$name]}"
      continue
    fi
    # A file that exists but cannot be parsed is its own state, not an excuse
    # to stop. certs::days_left returns non-zero there, and a bare assignment
    # under "set -e" ended the command on the spot: the table was truncated at
    # that row with no message and exit 1, hiding both the broken certificate
    # and every one after it.
    if ! days=$(certs::days_left "$name"); then
      printf -v padded '%-13s' 'unreadable'
      printf "$fmt" "$name" "${C_RED}${padded}${C_RESET}" '-' '-' "${NC_SPEC_DOMAINS[$name]}"
      continue
    fi
    issuer=$(certs::issuer "$name" | sed -n 's/.*CN *= *\([^,/]*\).*/\1/p'); issuer=${issuer:-unknown}
    reason=$(certs::renewal_reason "$name")

    if ((days < 0));                   then state='EXPIRED';      color=$C_RED
    elif certs::is_selfsigned "$name"; then state='local';        color=$C_ORANGE
    elif [[ -n $reason ]];             then state='renew due';    color=$C_YELLOW
    else                                    state='valid';        color=$C_GREEN
    fi

    # "D-5" means five days left; "-5d" means five days past expiry. "D--5"
    # said neither.
    local expiry="D-${days}"; ((days < 0)) && expiry="${days}d"
    printf -v padded '%-13s' "$state"
    printf "$fmt" "$name" "${color}${padded}${C_RESET}" "${issuer:0:26}" "$expiry" "${NC_SPEC_DOMAINS[$name]}"
  done

  # A legend only where it earns its place: when something is not simply fine.
  local warn_local=0 warn_due=0
  for name in "${NC_SPEC_NAMES[@]}"; do
    certs::exists "$name" || continue
    certs::is_selfsigned "$name" && warn_local=1
    [[ -n $(certs::renewal_reason "$name") ]] && warn_due=1
  done
  if ((warn_local)); then
    printf '\n%s%slocal%s%s = signed by this container, not publicly trusted; a real authority replaces it as soon as one succeeds.%s\n' \
      "$C_DIM" "$C_ORANGE" "$C_RESET" "$C_DIM" "$C_RESET"
  fi
  if ((warn_due)); then
    printf '%s%srenew due%s%s = will be renewed at the next check, or now with: certme renew%s\n' \
      "$C_DIM" "$C_YELLOW" "$C_RESET" "$C_DIM" "$C_RESET"
  fi
}

cmd::list() {
  local name
  for name in ${NC_SPEC_NAMES[@]+"${NC_SPEC_NAMES[@]}"}; do
    printf '%s\t%s\t%s\t%s\n' "$name" "${NC_SPEC_KIND[$name]}" \
      "${NC_SPEC_PROVIDER[$name]}" "${NC_SPEC_DOMAINS[$name]}"
  done
}

cmd::providers() {
  local fmt='%-22s %-26s %-9s %-22s %s\n'
  printf "$C_BOLD$fmt$C_RESET" 'ID' 'AUTHORITY' 'EAB' 'ACCEPTED KINDS' 'USABLE HERE'
  printf '%s%s%s\n' "$C_DIM" "$(printf -- '-%.0s' $(seq 1 92))" "$C_RESET"

  local id eab avail color
  while IFS= read -r id; do
    if provider::needs_eab "$id"; then eab='required'; else eab='no'; fi
    if provider::eab_available "$id"; then
      avail='yes'; color=$C_GREEN
    else
      avail='no -- EAB credentials missing'; color=$C_DIM
    fi
    local label; label=$(provider::label "$id")
    printf "$fmt" "$id" "${label:0:26}" "$eab" "${NC_PROVIDER_CAPS[$id]}" "${color}${avail}${C_RESET}"
  done < <(provider::list_ids)

  printf "$fmt" 'selfsigned' 'Local authority' 'no' 'all' "${C_ORANGE}yes (last resort)${C_RESET}"
  if zerossl_rest::available; then
    printf "$fmt" 'zerossl-rest' 'ZeroSSL (REST API)' 'no' 'ip' "${C_GREEN}yes${C_RESET}"
  else
    printf "$fmt" 'zerossl-rest' 'ZeroSSL (REST API)' 'no' 'ip' "${C_DIM}no -- CERT_ZEROSSL_API_KEY unset${C_RESET}"
  fi

  printf '\n%sPin one with CERT_PROVIDER, or set the order tried in auto mode with CERT_PROVIDER_CHAIN.%s\n' \
    "$C_DIM" "$C_RESET"
}

cmd::version() {
  printf 'nginx-cert  %s\n' "$NC_VERSION"
  printf 'nginx       %s\n' "$(nginx -v 2>&1 | sed 's|.*nginx/||')"
  printf 'acme.sh     %s\n' "$(acme::version 2>/dev/null || printf 'absent')"
  printf 'openssl     %s\n' "$(openssl version 2>/dev/null | cut -d' ' -f1-2)"
}

cmd::revoke() {
  local name=${1:-}
  [[ -z $name ]] && log::die "$EX_CONFIG" "Usage: certme revoke <name>. See 'certme list'."
  [[ -z ${NC_SPEC_DOMAINS[$name]:-} ]] && log::die "$EX_CONFIG" "Unknown certificate: '${name}'."

  # Which authority actually issued is recorded on disk at install time and
  # survives restarts. NC_LAST_PROVIDER only holds a value inside the process
  # that just issued, and "certme revoke" is always a fresh one -- so the
  # fallback below always fired, and "auto" was resolved to letsencrypt: the
  # revocation of a ZeroSSL certificate was announced, and sent, to the wrong
  # authority.
  local provider
  provider=$(certs::recorded_provider "$name" 2>/dev/null) \
    || provider=${NC_LAST_PROVIDER[$name]:-${NC_SPEC_PROVIDER[$name]}}

  if [[ $provider == selfsigned ]]; then
    log::die "$EX_CONFIG" \
      "'${name}' was issued by the local authority: there is nothing to revoke. Delete $(config::cert_path "$name") and reissue instead."
  fi
  if [[ -z $provider || $provider == auto ]]; then
    log::die "$EX_CONFIG" \
      "Cannot tell which authority issued '${name}' (nothing recorded in ${CFG_STATE_DIR}/issued-by/). Revoke it by hand: acme.sh --revoke -d <domain> --server <directory>."
  fi

  log::warn "Revoking '${name}' with $(provider::label "$provider")…"
  acme::revoke "$name" "$provider"
}

# Health probe: nginx must answer, and no certificate may be expired.
cmd::health() {
  if ! nginx::is_running; then
    printf 'nginx is not running\n' >&2; return 1
  fi
  if ! curl -fsS --max-time 3 -o /dev/null "http://127.0.0.1:${CFG_HTTP_PORT}/healthz" 2>/dev/null; then
    printf 'nginx is not answering on /healthz (port %s)\n' "$CFG_HTTP_PORT" >&2; return 1
  fi
  local name days expired=() unreadable=()
  for name in ${NC_SPEC_NAMES[@]+"${NC_SPEC_NAMES[@]}"}; do
    certs::exists "$name" || continue
    # An unparsable certificate is a failure that has to name itself. The bare
    # assignment ended this function through "set -e", so the probe exited 1
    # with no output at all: the container went unhealthy and "docker inspect"
    # showed an empty reason.
    if ! days=$(certs::days_left "$name"); then unreadable+=("$name"); continue; fi
    ((days < 0)) && expired+=("$name")
  done
  if ((${#unreadable[@]})); then
    printf 'unreadable certificate(s): %s\n' "${unreadable[*]}" >&2; return 1
  fi
  if ((${#expired[@]})); then
    printf 'expired certificate(s): %s\n' "${expired[*]}" >&2; return 1
  fi
  printf 'ok\n'
}

# --- Entry point -----------------------------------------------------------
main() {
  local cmd=${1:-help}; shift || true

  case $cmd in
    -h|--help|help) usage; return 0 ;;
  esac

  # --force is accepted on every issuance command.
  local -a rest=()
  local a
  for a in "$@"; do
    case $a in
      --force) export CERT_FORCE_RENEW=true ;;
      *) rest+=("$a") ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}

  config::load

  case $cmd in
    issue|renew)  cmd::issue "$@" ;;
    status)       cmd::status "$@" ;;
    list)         cmd::list ;;
    providers)    cmd::providers ;;
    config)       config::summary ;;
    render)       bootstrap::prepare_dirs; nginx::render && nginx::test ;;
    check)        nginx::test ;;
    reload)       nginx::reload ;;
    revoke)       cmd::revoke "$@" ;;
    health)       cmd::health ;;
    version)      cmd::version ;;
    *)            log::error "Unknown command: '${cmd}'."; usage >&2; return "$EX_CONFIG" ;;
  esac
}

main "$@"
