# Generated by nginx-cert -- TLS-ALPN-01 front (RFC 8737) on port %%HTTPS_PORT%%.
#
# Included at top level of nginx.conf, outside http. Empty unless a certificate
# uses CERT_CHALLENGE=tls-alpn-01.
#
# nginx reads the ALPN list of each TLS handshake without decrypting it:
#   - "acme-tls/1", which no browser sends, goes to acme.sh's responder. That
#     responder listens on the loopback during a validation only; otherwise the
#     connection is refused. It proves control of the name and grants nothing.
#   - everything else goes to the HTTPS servers on 127.0.0.1:%%BACKEND_PORT%%,
#     with the client address carried by the PROXY protocol.
%%IF ACTIVE%%
stream {
    map $ssl_preread_alpn_protocols $nc_tls_target {
        ~(^|,)acme-tls/1(,|$)  127.0.0.1:%%RELAY_PORT%%;
        default                127.0.0.1:%%BACKEND_PORT%%;
    }

    limit_conn_zone $binary_remote_addr zone=nc_acme:1m;

    server {
        listen          %%HTTPS_PORT%%;
        listen          [::]:%%HTTPS_PORT%%;
        ssl_preread     on;
        proxy_protocol  on;
        proxy_pass      $nc_tls_target;
    }

    # acme.sh speaks no PROXY protocol: this relay removes it, and bounds what
    # a stranger can hold open on the validation path.
    server {
        listen                 127.0.0.1:%%RELAY_PORT%% proxy_protocol;
        set_real_ip_from       127.0.0.1;
        limit_conn             nc_acme 4;
        proxy_connect_timeout  2s;
        proxy_timeout          10s;
        proxy_pass             127.0.0.1:%%RESPONDER_PORT%%;
    }
}
%%ENDIF%%
